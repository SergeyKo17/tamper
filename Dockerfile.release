# syntax=docker/dockerfile:1

# The image published by a release carries the binary the release itself ships,
# rather than one built a second time by a second toolchain. goreleaser
# cross-compiles, puts the binary in the build context and points here.
FROM gcr.io/distroless/static:nonroot
COPY tamper /tamper

EXPOSE 9090

ENTRYPOINT ["/tamper"]
CMD ["-config", "/etc/tamper/tamper.yml"]
